# Copy to `.env` (next to manage.py) and edit. The app reads it with python-dotenv.
# DEBUG is read as plain text: any non-empty value turns debug mode on, even "False".
# Leave it empty (DEBUG=) to turn debug mode off.
DEBUG=True

DB_NAME=chatbothub
DB_USER=chatbothub
DB_PASSWORD=chatbothub
DB_HOST=localhost
DB_PORT=5432

OPENAI_KEY=your-api-key
OPENAI_BASEURL=https://api.openai.com/v1
